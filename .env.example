NODE_ENV=development
PORT=3333

# MariaDB
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_NAME=db_rede_campo_online
DB_PASS=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1d

# CORS / Rate-limit (opcional)
# Vazio = reflete a origem da requisicao (dev local).
# Em producao, liste as origens separadas por virgula:
# CORS_ORIGIN=https://meu-front.com,https://www.meu-front.com
CORS_ORIGIN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Numero de proxies reversos a frente da API.
# 0 (ou ausente) = execucao local sem proxy. 1 = atras de Railway/Nginx/etc.
TRUST_PROXY=0

# Cloudflare R2
# Dashboard → R2 → Account ID (top-right of the R2 overview page)
R2_ACCOUNT_ID=

# Dashboard → R2 → Manage R2 API Tokens → Create Token → Access Key ID
R2_ACCESS_KEY_ID=

# Dashboard → R2 → Manage R2 API Tokens → Create Token → Secret Access Key
R2_SECRET_ACCESS_KEY=

# Dashboard → R2 → your bucket name
R2_BUCKET_NAME=

# Public base URL with no trailing slash.
# Either your custom domain (e.g. https://cdn.example.com)
# or the r2.dev public URL enabled in Dashboard → R2 → bucket → Settings → Public Access
R2_PUBLIC_URL=
